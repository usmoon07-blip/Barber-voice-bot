# Telegram bot tokeni (@BotFather dan)
BOT_TOKEN=
# Barbershop egasining Telegram ID raqami (@userinfobot dan bilish mumkin)
OWNER_ID=
# Admin panel kaliti: uzun tasodifiy satr (masalan: openssl rand -hex 16)
ADMIN_KEY=
# Anthropic API kaliti
ANTHROPIC_API_KEY=
# Google Cloud service account JSON fayli yo'li (Speech-to-Text va Text-to-Speech yoqilgan)
GOOGLE_APPLICATION_CREDENTIALS=/opt/barber-bot/google-key.json
# Admin panelning tashqi manzili (ixtiyoriy), masalan http://123.45.67.89:8080
PUBLIC_URL=
# Admin panel porti
PORT=8080
